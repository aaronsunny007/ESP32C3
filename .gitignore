# Spotify credentials: never commit
secrets.h
**/secrets.h

# Arduino / PlatformIO build output
build/
.pio/
*.bin
*.elf
*.map

# Android app build output and local machine files
phone-app/.gradle/
phone-app/**/build/
phone-app/local.properties
*.apk
*.keystore
*.jks
